{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ninja-release",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS ARM64 Release",
      "inherits": "ninja-release",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-arm64-sanitizers",
      "displayName": "macOS ARM64 ASan + UBSan Debug",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "IL2CPPREC_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "windows-x64-msvc",
      "displayName": "Windows x64 MSVC",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "windows-x64-mingw",
      "displayName": "Windows x64 MinGW-w64 Release",
      "inherits": "ninja-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-x64-mingw.cmake"
    },
    {
      "name": "android-arm64",
      "displayName": "Android ARM64 Release",
      "inherits": "ninja-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/android-arm64.cmake",
      "cacheVariables": {
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "ios-arm64",
      "displayName": "iOS ARM64",
      "inherits": "base",
      "generator": "Xcode",
      "toolchainFile": "${sourceDir}/cmake/toolchains/ios-arm64.cmake",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "IL2CPPREC_BUILD_CLI": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64"
    },
    {
      "name": "macos-arm64-sanitizers",
      "configurePreset": "macos-arm64-sanitizers"
    },
    {
      "name": "windows-x64-msvc",
      "configurePreset": "windows-x64-msvc",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-mingw",
      "configurePreset": "windows-x64-mingw"
    },
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64"
    },
    {
      "name": "ios-arm64",
      "configurePreset": "ios-arm64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-sanitizers",
      "configurePreset": "macos-arm64-sanitizers",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x64-msvc",
      "configurePreset": "windows-x64-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x64-mingw",
      "configurePreset": "windows-x64-mingw",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
