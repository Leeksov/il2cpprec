if(DEFINED ENV{ANDROID_NDK_HOME} AND NOT "$ENV{ANDROID_NDK_HOME}" STREQUAL "")
    set(_IL2CPPREC_ANDROID_NDK "$ENV{ANDROID_NDK_HOME}")
elseif(DEFINED ENV{ANDROID_NDK_ROOT} AND NOT "$ENV{ANDROID_NDK_ROOT}" STREQUAL "")
    set(_IL2CPPREC_ANDROID_NDK "$ENV{ANDROID_NDK_ROOT}")
else()
    message(FATAL_ERROR "Set ANDROID_NDK_HOME or ANDROID_NDK_ROOT to an existing Android NDK installation.")
endif()

set(_IL2CPPREC_ANDROID_TOOLCHAIN "${_IL2CPPREC_ANDROID_NDK}/build/cmake/android.toolchain.cmake")
if(NOT EXISTS "${_IL2CPPREC_ANDROID_TOOLCHAIN}")
    message(FATAL_ERROR "Android NDK toolchain was not found at ${_IL2CPPREC_ANDROID_TOOLCHAIN}.")
endif()

set(ANDROID_ABI arm64-v8a CACHE STRING "Android ABI")
set(ANDROID_PLATFORM android-21 CACHE STRING "Android API level")
include("${_IL2CPPREC_ANDROID_TOOLCHAIN}")

unset(_IL2CPPREC_ANDROID_NDK)
unset(_IL2CPPREC_ANDROID_TOOLCHAIN)
